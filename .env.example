NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/ai_ecommerce
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_ecommerce
DB_USER=app_user
DB_PASSWORD=replace_me
JWT_SECRET=generate_a_unique_random_value_of_at_least_32_characters
ENABLE_LEGACY_PROVIDER_ROUTES=false
ENABLE_LEGACY_PUBLIC_INTAKE=false
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional live growth connectors. Secrets belong only in the ignored .env.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-04
SOCIAL_EVIDENCE_API_URL=
SOCIAL_EVIDENCE_API_TOKEN=
SUPPLIER_CATALOG_API_URL=
SUPPLIER_CATALOG_API_TOKEN=
UGC_VIDEO_API_URL=
UGC_VIDEO_API_TOKEN=
SOCIAL_PUBLISHING_API_URL=
SOCIAL_PUBLISHING_API_TOKEN=
META_ADS_CONNECTOR_URL=
META_ADS_ACCESS_TOKEN=
TIKTOK_ADS_CONNECTOR_URL=
TIKTOK_ADS_ACCESS_TOKEN=
PAYMENT_PROVIDER_TOKEN=
INVENTORY_PROVIDER_TOKEN=
DELIVERY_PROVIDER_TOKEN=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false

# Post-sale dropshipping operations connectors. Keep real values only in ignored .env.
SUPPLIER_ORDER_API_URL=
SUPPLIER_ORDER_API_TOKEN=
DROPSHIP_CATALOG_SYNC_API_URL=
DROPSHIP_CATALOG_SYNC_API_TOKEN=
DROPSHIP_TRACKING_API_URL=
DROPSHIP_TRACKING_API_TOKEN=
